# Database
DATABASE_URL=postgresql+asyncpg://anward@localhost:5432/kaleido

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-secure-256-bit-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
ENCRYPTION_KEY=change-me-to-a-32-byte-key-here!

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# ComfyUI
COMFYUI_BASE_URL=http://localhost:8188

# Frontend URL (for CORS)
FRONTEND_URL=https://kaleido.social

# File Storage
MEDIA_ROOT=/data/kaleido
MAX_UPLOAD_SIZE_MB=50

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false
